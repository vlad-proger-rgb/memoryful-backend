# Local Development Environment Configuration
# Used with docker-compose.local.yml
# All services run locally - no external dependencies

ENVIRONMENT=development
SEED_DB_ON_EMPTY=true
CACHE_ENABLED=true

# GCP Settings (local emulators)
GCP_PROJECT_ID=memoryful
USE_SECRET_MANAGER=false
GCP_CREDENTIALS_PATH=/app/secrets/google/service-account.json

# Google OAuth
GOOGLE_CLIENT_IDS=653639305096-2peqvdvsnjh1cf9gt632lqfbod4bcln9.apps.googleusercontent.com

# Database (local PostgreSQL container)
POSTGRES_USER=main_user
POSTGRES_PASSWORD=main_password
POSTGRES_PORT=5432
POSTGRES_HOST=db
POSTGRES_DB=main_database
POSTGRES_SSLMODE=prefer

# Authentication (dev keys - not secure)
ACCESS_SECRET_KEY=dev_access_secret_key_change_in_production
REFRESH_SECRET_KEY=dev_refresh_secret_key_change_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# Redis (local container)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=dev_redis_password
REDIS_SSL=false

SQL_ECHO=true

# Email (Resend - use your dev API key)
RESEND_API_KEY=your_resend_api_key_here
MAIL_FROM=dev@noreply.memory-ful.com
MAIL_FROM_NAME=Memoryful Dev

# CORS (local frontend)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
ALLOW_CREDENTIALS=true
ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
ALLOWED_HEADERS=Content-Type,Authorization,Set-Cookie

# Trusted Emails
TRUSTED_EMAILS=dev@example.com

# Storage (local SeaweedFS container)
S3_ENDPOINT_URL=http://seaweedfs:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_REGION=us-east-1
S3_BUCKET=memoryful
S3_PUBLIC_BASE_URL=http://localhost:9000

# LLM Settings
# Model selection comes from the `chat_models` DB catalog (app/ai/catalog.py).
# LLM_MODE only picks the gateway:
#   local  -> everything served by the Ollama container below (no cloud calls, no cost)
#   vertex -> real cloud models via GCP Vertex AI; needs valid ADC (GCP_CREDENTIALS_PATH)
LLM_MODE=local
LLM_TEMPERATURE=0.4

# Used when LLM_MODE=vertex. "global" has the widest model availability.
VERTEX_LOCATION=global

# Used when LLM_MODE=local.
LOCAL_LLM_BASE_URL=http://ollama:11434/v1
LOCAL_LLM_MODEL=llama3.1
LOCAL_LLM_API_KEY=local

# AI providers via Workload Identity Federation; GCP_CREDENTIALS_PATH impersonates this account
GCP_AI_SERVICE_ACCOUNT=ai-workload-identity@memoryful.iam.gserviceaccount.com

# Claude's federation rule
ANTHROPIC_FEDERATION_RULE_ID=fdrl_014KhxM8CSD5TLWzeudDTCMD
ANTHROPIC_ORGANIZATION_ID=b1abb7af-927b-420f-97f5-f514abf81c68
ANTHROPIC_SERVICE_ACCOUNT_ID=svac_01KsZ5MfMJ3D8PcqkmSEvvWv
ANTHROPIC_WORKSPACE_ID=wrkspc_01J1Ron2mK2RpLeQyBiovMzi

# OpenAI's workload identity provider and mapped service account
OPENAI_IDENTITY_PROVIDER_ID=idp_103fda280c0db7e70bfb5785
OPENAI_SERVICE_ACCOUNT_ID=user-XF9kJxZcA3ORfw36RO3zq21j

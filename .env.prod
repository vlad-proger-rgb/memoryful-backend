# Production Environment Configuration
# Copy this file to .env and fill in your actual values
# Secrets (DB credentials, API keys, etc.) are fetched from GCP Secret Manager

ENVIRONMENT=production
SEED_DB_ON_EMPTY=false

# GCP Settings
GCP_PROJECT_ID=memoryful
USE_SECRET_MANAGER=true
GCP_CREDENTIALS_PATH=/app/secrets/google/service-account.json

# Google OAuth
GOOGLE_CLIENT_IDS=653639305096-2peqvdvsnjh1cf9gt632lqfbod4bcln9.apps.googleusercontent.com

# Google Artifact Registry (for docker-compose deployment)
GAR_REGION=europe-central2
GAR_REPOSITORY=memoryful-backend

# GCP PubSub (Celery Broker)
GCP_PUBSUB_PROJECT_ID=memoryful

# Database (connection details - credentials from Secret Manager)
POSTGRES_PORT=5432
POSTGRES_DB=neondb
POSTGRES_SSLMODE=require

# Redis (connection details - credentials from Secret Manager)
REDIS_PORT=6379
REDIS_DB=0
REDIS_SSL=true

# Email
MAIL_FROM_NAME=Memoryful

# CORS
ALLOWED_ORIGINS=https://www.memory-ful.com,https://memory-ful.com
ALLOW_CREDENTIALS=true
ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
ALLOWED_HEADERS=Content-Type,Authorization,Set-Cookie

# Trusted Emails: development-only login bypass, ignored unless ENVIRONMENT=development

# Storage (GCS)
S3_ENDPOINT_URL=https://storage.googleapis.com
S3_REGION=europe-central2
S3_BUCKET=memoryful
S3_PUBLIC_BASE_URL=https://storage.googleapis.com

# Token Expiration
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# LLM Settings
# Model selection is per-request from the `chat_models` DB catalog (app/ai/catalog.py).
# LLM_MODE chooses the gateway; in prod that's Vertex AI (ADC auth, no API keys).
LLM_MODE=vertex
LLM_TEMPERATURE=0.4
# "global" routes across regions and has the widest model availability; partner
# models (Claude, Grok) are frequently offered there only.
VERTEX_LOCATION=global

# AI providers via Workload Identity Federation; GCP_CREDENTIALS_PATH impersonates this account
GCP_AI_SERVICE_ACCOUNT=ai-workload-identity@memoryful.iam.gserviceaccount.com

# Claude's federation rule
ANTHROPIC_FEDERATION_RULE_ID=fdrl_014KhxM8CSD5TLWzeudDTCMD
ANTHROPIC_ORGANIZATION_ID=b1abb7af-927b-420f-97f5-f514abf81c68
ANTHROPIC_SERVICE_ACCOUNT_ID=svac_01KsZ5MfMJ3D8PcqkmSEvvWv
ANTHROPIC_WORKSPACE_ID=wrkspc_01J1Ron2mK2RpLeQyBiovMzi

# OpenAI's workload identity provider and mapped service account
OPENAI_IDENTITY_PROVIDER_ID=idp_103fda280c0db7e70bfb5785
OPENAI_SERVICE_ACCOUNT_ID=user-XF9kJxZcA3ORfw36RO3zq21j
